# Archivo de credenciales CIFS para montaje seguro de Windows
# Ubicación recomendada en el servidor Debian: /etc/cifs-credentials-ctg
# Permisos requeridos: chmod 600 /etc/cifs-credentials-ctg (solo root)
# Propietario: chown root:root /etc/cifs-credentials-ctg

username=USUARIO_WINDOWS
password=PASSWORD_WINDOWS
domain=DOMINIO_O_WORKGROUP
