USERNAMEPAGE=Trium
PASSWORDPAGE=TuContrasenaAqui
APP_BASE_URL=https://172.16.1.75

# Scraper Optimization
MAX_CONSECUTIVE_SKIPPED_PAGES=2
CONCURRENT_DOWNLOADS=3
#MAX_PAGES=2

# Browser config
HEADLESS=true
BROWSER_CHANNEL=chrome
# BROWSER_PROFILE=./profile

# Directorios de almacenamiento desacoplados
# Local (disco ext4 rápido y seguro para el bot)
OUTPUT_DIR_LOCAL=/home/rpatic/Monitoreo_Fetal_local
# Remoto (punto de montaje CIFS blindado hacia Windows)
OUTPUT_DIR_REMOTE=/mnt/Monitoreo_Fetal
# Ruta de compatibilidad retroactiva (si se define, anula OUTPUT_DIR_LOCAL)
#OUTPUT_DIR=./ArchivoCTG

# Configuración de Observabilidad y Watchdog
WATCHDOG_THRESHOLD_MINUTES=20
# Webhook URL para alertas (Slack, Teams, Discord, etc.)
#WEBHOOK_URL=https://webhook.site/your-webhook-token
